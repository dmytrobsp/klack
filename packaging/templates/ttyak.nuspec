<!-- Rendered by packaging/render.py from the release's SHA256SUMS (github.com/dmytrobsp/ttyak); edit the template. -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>ttyak</id>
    <version>{{version}}</version>
    <packageSourceUrl>https://github.com/dmytrobsp/ttyak/tree/master/packaging</packageSourceUrl>
    <owners>{{name}}</owners>
    <title>ttyak</title>
    <authors>{{name}}</authors>
    <projectUrl>{{homepage}}</projectUrl>
    <licenseUrl>https://github.com/dmytrobsp/ttyak#licence</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/dmytrobsp/ttyak</projectSourceUrl>
    <docsUrl>https://github.com/dmytrobsp/ttyak#readme</docsUrl>
